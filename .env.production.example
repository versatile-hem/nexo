# EC2 Deployment Environment Configuration Template
# 
# Copy this file to your EC2 instance and update with your values
# Typically placed at: /home/ubuntu/nexo-app/.env.production

# Application
VITE_API_BASE_URL=http://YOUR_EC2_IP:8080/api
NODE_ENV=production

# Build configuration
VITE_BUILD_TARGET=es2015
VITE_SOURCEMAP=false

# Security
VITE_API_TIMEOUT=30000

# Feature flags (if applicable)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_TOOLS=false
